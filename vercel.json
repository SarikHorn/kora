{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/book/index.html" },
    { "source": "/materials", "destination": "/book/materials.html" },
    { "source": "/assets/(.*)", "destination": "/book/assets/$1" },
    { "source": "/book", "destination": "/book/index.html" },
    { "source": "/book/(.*)", "destination": "/book/$1" },
    { "source": "/Computer_for_Ministry_CPTIs.zip", "destination": "/book/Computer_for_Ministry_CPTIs.zip" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/book/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
